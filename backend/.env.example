PORT=5000
NODE_ENV=development

# Database Connection Options:
# 1. Local SQLite (Default for offline development):
DATABASE_URL="file:./dev.db"

# 2. Cloud PostgreSQL (Neon / Supabase / Render Postgres / Aiven - Recommended for Cloud Free Tier):
# DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# 3. MySQL 8:
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/fleetpulse360?schema=public"

JWT_SECRET="REPLACE_WITH_DEV_JWT_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:5173"
