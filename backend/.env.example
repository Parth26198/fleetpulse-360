PORT=5000
NODE_ENV=development

# Database Connection (Default SQLite for instant runnable development)
DATABASE_URL="file:./dev.db"

# For MySQL 8 (Uncomment and configure your MySQL credentials when running on MySQL):
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/fleetpulse360?schema=public"

JWT_SECRET="REPLACE_WITH_DEV_JWT_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:5173"
