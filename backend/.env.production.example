# ==============================================================================
# FLEETPULSE 360 — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# CAUTION: Never commit actual production secrets to version control.
# Copy this file to .env.production on your secure production server and populate
# with secrets generated by your security team or secrets vault (e.g. AWS Secrets Manager, Vault).

# Server Runtime
NODE_ENV=production
PORT=5000

# Production Database (MySQL 8.0+ Enterprise)
# Format: mysql://<USER>:<STRONG_PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslmode=require&connection_limit=25
DATABASE_URL=mysql://fleetpulse_admin:CHANGE_TO_STRONG_PASSWORD_32_CHARS@db.fleetpulse360.internal:3306/fleetpulse360_prod?sslmode=require

# Cryptographic JSON Web Token Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 64 hex characters (256-bit entropy)
JWT_SECRET=REPLACE_WITH_GENERATED_64_CHAR_HEX_ENTROPY_KEY_IN_PRODUCTION
JWT_EXPIRES_IN=24h

# Domain & Cross-Origin Security
FRONTEND_URL=https://app.fleetpulse360.com
CORS_ALLOWED_ORIGINS=https://app.fleetpulse360.com,https://admin.fleetpulse360.com

# File Ingestion & Storage Limits
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging & Telemetry
LOG_LEVEL=info
ENABLE_STACK_TRACES=false
